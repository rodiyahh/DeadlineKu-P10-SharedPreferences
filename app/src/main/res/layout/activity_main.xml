<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_header"
    android:orientation="vertical">

    <!-- Header berwarna -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:text="DEADLINEKU"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSapaan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Halo!"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pengingat"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Badan layar dengan sudut atas melengkung -->
    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_body"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="TAMBAH TUGAS"
                android:textColor="#5C6BC0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etJudul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Judul tugas (mis. Laporan Praktikum)"
                android:inputType="textCapSentences" />

            <EditText
                android:id="@+id/etMatkul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mata kuliah"
                android:inputType="textCapWords" />

            <Button
                android:id="@+id/btnTanggal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_outline"
                android:minHeight="48dp"
                android:stateListAnimator="@null"
                android:text="Pilih Deadline"
                android:textAllCaps="false"
                android:textColor="#5C6BC0"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTambah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_primary"
                android:minHeight="48dp"
                android:stateListAnimator="@null"
                android:text="Tambah Tugas"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Daftar tugas"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:alpha="0.6"
            android:text="Tekan lama pada tugas untuk menghapus"
            android:textSize="12sp" />

        <ListView
            android:id="@+id/lvTugas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp" />

        <TextView
            android:id="@+id/tvKosong"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:alpha="0.6"
            android:gravity="center"
            android:text="Belum ada tugas.\nTambahkan yang pertama!"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPengaturan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_outline"
            android:minHeight="48dp"
            android:stateListAnimator="@null"
            android:text="Pengaturan"
            android:textAllCaps="false"
            android:textColor="#5C6BC0"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
